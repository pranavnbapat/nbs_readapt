# App
APP_NAME=espon-readapt
APP_ENV=development
APP_DEBUG=true
APP_PORT=9500
APP_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_HOST=true
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Database
DB_ENGINE=postgres
POSTGRES_DB=espon_readapt
POSTGRES_USER=espon_readapt
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PUBLIC_PORT=9501

# Alternative MySQL variables if the project later switches
MYSQL_DATABASE=espon_readapt
MYSQL_USER=espon_readapt
MYSQL_PASSWORD=change-me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PUBLIC_PORT=9505

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_PUBLIC_PORT=9503
OPENSEARCH_METRICS_PUBLIC_PORT=9504
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe!2026
OPENSEARCH_INDEX_BM25=espon_repository_bm25
OPENSEARCH_INDEX_NEURAL=espon_repository_neural
OPENSEARCH_INGEST_PIPELINE=espon_repository_ingest
OPENSEARCH_HYBRID_PIPELINE=espon_repository_hybrid

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=
RUNPOD_VLLM_HOST=
VLLM_CHAT_COMPLETIONS_URL=
VLLM_MODEL=
VLLM_MAX_MODEL_LEN=65535
VLLM_API_KEY=
ASSISTANT_TIMEOUT_SECONDS=120
ASSISTANT_MAX_HISTORY_MESSAGES=6
ASSISTANT_CONTEXT_RECORDS=6
ASSISTANT_CONTEXT_FIELD_CHARS=280
ASSISTANT_CONTEXT_RECORD_CHARS=1200
ASSISTANT_MAX_QUERY_CHARS=4000
ASSISTANT_APPROX_CHARS_PER_TOKEN=3.2
ASSISTANT_MAX_INPUT_TOKENS=0
ASSISTANT_TOKEN_SAFETY_MARGIN=0
ASSISTANT_RESPONSE_STYLE_DEFAULT=standard
ASSISTANT_RELEVANCE_MIN_SCORE=5.0

# Paths
INITIAL_INPUT_DIR=initial_input
DATA_DIR=data

# Admin / tooling
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PHPMYADMIN_PORT=9506
PGADMIN_PORT=9502

# Traefik / deployment
APP_DOMAIN=espon-readapt.example.com
LETSENCRYPT_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_HOST=traefik-espon-readapt.example.com
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$apr1$$replace-with-htpasswd-hash
